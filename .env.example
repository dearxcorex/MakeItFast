# Database (used by Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/fm_station_tracker"

# Session encryption — required.
# Generate with: openssl rand -base64 32
# Rotating this value logs every user out (existing cookies become undecryptable).
SESSION_PASSWORD="paste-32-char-secret-here-paste-32-char-secret-here"

# Initial admin user (read only by `npx prisma db seed`)
# Change the admin's password via /admin/users after first login.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="changeMeAfterFirstLogin"
ADMIN_DISPLAY_NAME="Admin"

# Discord `/stat` bot (POST /api/discord/interactions)
# Developer Portal → your application → General Information
DISCORD_APPLICATION_ID=""
DISCORD_PUBLIC_KEY=""
# Discord (Developer Mode on) → right-click the server → Copy Server ID
DISCORD_GUILD_ID=""
# Right-click the channel → Copy Channel ID. Comma-separated allowlist: the bot
# answers only in these channels. Leave empty to allow any channel.
# e.g. "<#field-ops-bot id>,<#dear-th-ai-passport id>"
DISCORD_CHANNEL_ID=""
# Developer Portal → Bot → Reset Token. LOCAL ONLY: read by
# scripts/register-discord-commands.ts; do not add it to Vercel.
DISCORD_BOT_TOKEN=""
# Inspection notices: Discord → #field-ops-bot → Edit Channel → Integrations →
# Webhooks → New Webhook (name it DEARBOT) → Copy Webhook URL. Leave empty to
# turn notices off. Vercel needs this one (unlike DISCORD_BOT_TOKEN).
DISCORD_INSPECTION_WEBHOOK_URL=""
# Linked from the /stat embed title; leave empty to omit the link
SITE_URL=""

# Discord `/ask` bot (LLM). platform.deepseek.com → API keys.
# Vercel needs this one. Without it /ask replies that it is not configured.
DEEPSEEK_API_KEY=""
# Optional model overrides — DeepSeek renames models from time to time.
# DEEPSEEK_ROUTER_MODEL runs the tool loop; DEEPSEEK_SEARCH_MODEL runs web search.
DEEPSEEK_ROUTER_MODEL=""
DEEPSEEK_SEARCH_MODEL=""
# Max /ask calls per Discord user per day (Bangkok date). Default 30.
ASK_DAILY_LIMIT=""
