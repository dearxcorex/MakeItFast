generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model fm_station {
  id_fm            Int      @id @default(autoincrement())
  name             String?
  freq             Float?
  lat              Float?
  long             Float?
  district         String?
  province         String?
  type             String?
  inspection_68    Boolean? @default(false)
  inspection_69    Boolean? @default(false)
  on_air           Boolean? @default(false)
  submit_a_request Boolean? @default(false)
  date_inspected   String?
  note             String?
  revoked          Boolean? @default(false)
  revoked_note     String?
  permit           String?

  inspections   station_inspection[]

  @@index([revoked])
}

model interference_site {
  id                Int      @id @default(autoincrement())
  site_code         String?
  site_name         String?
  lat               Float?
  long              Float?
  mc_zone           String?
  changwat          String?
  cell_name         String?
  sector_name       String?
  direction         Float?
  avg_ni_carrier    Float?
  day_time          Float?
  night_time        Float?
  source_lat        Float?
  source_long       Float?
  estimate_distance Float?
  ranking           String?
  status            String?
  nbtc_area         String?
  awn_contact       String?
  lot               String?
  on_site_scan_by   String?
  on_site_scan_date String?
  check_realtime    String?
  source_location_1 String?
  source_location_2 String?
  camera_model_1    String?
  camera_model_2    String?
  notes             String?
  law_paper_sent    Boolean? @default(false)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  @@index([changwat])
  @@index([ranking])
  @@index([nbtc_area])
}

model cloudrf_cache {
  id             Int      @id @default(autoincrement())
  request_type   String
  request_hash   String   @unique
  request_params Json
  response_data  Json
  png_url        String?
  bounds         Json?
  viewer_url     String?
  site_id        Int?
  created_at     DateTime @default(now())
  expires_at     DateTime
}

model user {
  id            Int      @id @default(autoincrement())
  username      String   @unique
  password_hash String
  display_name  String
  role          String   @default("inspector")
  active        Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  created_by    Int?
  default_helper_user_ids Int[]     @default([])
  crew_decided            Boolean   @default(false)

  inspections_led    station_inspection[]        @relation("inspection_lead")
  inspection_members station_inspection_member[]

  @@index([username])
}

model station_inspection {
  id            Int       @id @default(autoincrement())
  station_id    Int
  inspected_on  DateTime  @db.Date
  lead_user_id  Int
  notes         String?
  source        String    @default("app")
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  station fm_station @relation(fields: [station_id], references: [id_fm])
  lead    user       @relation("inspection_lead", fields: [lead_user_id], references: [id])
  members station_inspection_member[]

  @@index([station_id, inspected_on(sort: Desc)])
  @@index([lead_user_id])
  @@unique([station_id, inspected_on, lead_user_id])
}

model station_inspection_member {
  inspection_id Int
  user_id       Int
  role          String  @default("helper")

  inspection station_inspection @relation(fields: [inspection_id], references: [id], onDelete: Cascade)
  member     user               @relation(fields: [user_id], references: [id])

  @@id([inspection_id, user_id])
  @@index([user_id])
}
