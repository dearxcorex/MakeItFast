generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model fm_station {
  id_fm            Int      @id @default(autoincrement())
  name             String?
  freq             Float?
  lat              Float?
  long             Float?
  district         String?
  province         String?
  type             String?
  inspection_68    Boolean? @default(false)
  inspection_69    Boolean? @default(false)
  on_air           Boolean? @default(false)
  submit_a_request Boolean? @default(false)
  date_inspected   String?
  note             String?
  revoked          Boolean? @default(false)
  revoked_note     String?
  permit           String?

  inspections   station_inspection[]

  @@index([revoked])
  @@index([inspection_69])
  @@index([on_air])
  @@index([submit_a_request])
  @@index([province])
}

model interference_site {
  id                Int      @id @default(autoincrement())
  site_code         String?
  site_name         String?
  lat               Float?
  long              Float?
  mc_zone           String?
  changwat          String?
  cell_name         String?
  sector_name       String?
  direction         Float?
  avg_ni_carrier    Float?
  day_time          Float?
  night_time        Float?
  source_lat        Float?
  source_long       Float?
  estimate_distance Float?
  ranking           String?
  status            String?
  nbtc_area         String?
  awn_contact       String?
  lot               String?
  on_site_scan_by   String?
  on_site_scan_date String?
  check_realtime    String?
  source_location_1 String?
  source_location_2 String?
  camera_model_1    String?
  camera_model_2    String?
  notes             String?
  law_paper_sent    Boolean? @default(false)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  inspections interference_inspection[]

  @@index([changwat])
  @@index([ranking])
  @@index([nbtc_area])
  @@index([status])
}

model user {
  id            Int      @id @default(autoincrement())
  username      String   @unique
  password_hash String
  display_name  String
  role          String   @default("inspector")
  active        Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  created_by    Int?
  must_change_password Boolean @default(false)
  // Bumped on every password write. Sessions seal the value they were issued
  // under, so a session minted before a reset no longer matches and is refused
  // — this is what makes an admin reset actually cut off live access.
  session_epoch        Int     @default(0)

  inspections_led        station_inspection[]             @relation("inspection_lead")
  inspection_members     station_inspection_member[]
  int_inspections_led    interference_inspection[]        @relation("int_inspection_lead")
  int_inspection_members interference_inspection_member[] @relation("int_inspection_member")

  @@index([username])
}

model station_inspection {
  id            Int       @id @default(autoincrement())
  station_id    Int
  inspected_on  DateTime  @db.Date
  lead_user_id  Int
  notes         String?
  source        String    @default("app")
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  station fm_station @relation(fields: [station_id], references: [id_fm])
  lead    user       @relation("inspection_lead", fields: [lead_user_id], references: [id])
  members station_inspection_member[]

  @@index([station_id, inspected_on(sort: Desc)])
  @@index([lead_user_id])
  @@unique([station_id, inspected_on, lead_user_id])
}

model station_inspection_member {
  inspection_id Int
  user_id       Int
  role          String  @default("helper")

  inspection station_inspection @relation(fields: [inspection_id], references: [id], onDelete: Cascade)
  member     user               @relation(fields: [user_id], references: [id])

  @@id([inspection_id, user_id])
  @@index([user_id])
}

model interference_inspection {
  id                Int       @id @default(autoincrement())
  interference_id   Int
  inspected_on      DateTime  @db.Date
  lead_user_id      Int
  notes             String?
  source            String    @default("app")
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  site    interference_site               @relation(fields: [interference_id], references: [id])
  lead    user                             @relation("int_inspection_lead", fields: [lead_user_id], references: [id])
  members interference_inspection_member[]

  @@index([interference_id, inspected_on(sort: Desc)])
  @@index([lead_user_id])
  @@unique([interference_id, inspected_on, lead_user_id])
}

model interference_inspection_member {
  inspection_id Int
  user_id       Int
  role          String  @default("helper")

  inspection interference_inspection @relation(fields: [inspection_id], references: [id], onDelete: Cascade)
  member     user                     @relation("int_inspection_member", fields: [user_id], references: [id])

  @@id([inspection_id, user_id])
  @@index([user_id])
}
